generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  role      String    @default("EMPLOYEE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  employee  Employee?
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model LeavePolicy {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  plMonthlyAllowance Int      @default(0)
  plRepeatMonthly    Boolean  @default(true)
  annualCl           Int      @default(0)
  annualSl           Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model Employee {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  userId                String         @unique @db.ObjectId
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  middleName            String?
  lastName              String
  dateOfBirth           DateTime?
  gender                String?
  jobRole               String?
  addressLine1          String?
  addressLine2          String?
  addressLine3          String?
  country               String?
  state                 String?
  city                  String?
  pincode               String?
  phone                 String
  panNumber             String?
  aadharNumber          String?
  bankAccountNumber     String?
  accountType           String?
  ifscCode              String?
  bankName              String?
  bankBranchName        String?
  aadharCardUrl         String?
  panCardUrl            String?
  cancelledChequeUrl    String?
  degreeCertificateUrls String[]
  resumeUrl             String?
  isArchived            Boolean        @default(false)
  isProfileLocked       Boolean        @default(false)
  documentsStatus       String         @default("NOT_SUBMITTED")
  documentsRejectedReason String?
  documentReviews       Json?
  joiningDate           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  leaveBalance          LeaveBalance?
  leaveRequests         LeaveRequest[]
  dailyTasks            DailyTask[]
}

model LeaveBalance {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId          String   @unique @db.ObjectId
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pl                  Int      @default(0)
  cl                  Int      @default(0)
  sl                  Int      @default(0)
  lwpUsed             Int      @default(0)
  lastPlAccrualPeriod String?
  lastClSlCreditFY    String?
  updatedAt           DateTime @updatedAt
}

model LeaveRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId   String   @db.ObjectId
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    String
  leaveBreakdown Json?
  startDate    DateTime
  endDate      DateTime
  reason       String
  days         Int?
  sandwichDays Int      @default(0)
  status       String   @default("PENDING")
  adminNote    String?
  medicalCertificateUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HrPolicyDocument {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  displayName    String
  storedFilename String
  mimeType       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CompanyHoliday {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  dateKey     String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyTask {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String   @db.ObjectId
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskDate        DateTime
  title           String
  description     String?
  status          String   @default("PLANNED")
  assignedByAdmin Boolean  @default(false)
  priority        String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId, taskDate])
}
